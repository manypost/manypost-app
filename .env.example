# manypost — configuração mínima (validada por packages/config, fail-fast)
MODE=all
PORT=3000
# Origem do produto para PESSOAS (interface web): OAuth dos canais, link de aprovação,
# URL pública da mídia e cookies saem daqui. Não é o endereço da API para máquinas.
PUBLIC_URL=http://localhost:3000

# Superfícies de MÁQUINA em hosts dedicados (SPEC_API_MCP §3/§5) — opcionais.
# São o MESMO serviço de API (2º e 3º domínio custom apontando para ele): o roteamento é por
# Host, sem proxy do Next no meio. Deixe vazio no self-host de um domínio só — aí a API de
# máquina fica em {PUBLIC_URL}/public/v1 e o MCP em {PUBLIC_URL}/mcp.
#   api. → API REST das integrações em /v1 (chave mp_live_ em Authorization: Bearer)
#   mcp. → servidor MCP na RAIZ (é a URL que o usuário cola no Claude/Cursor)
# API_PUBLIC_URL=https://api.manypost.com.br
# MCP_PUBLIC_URL=https://mcp.manypost.com.br
#
# ATENÇÃO ao proxy do web: o `API_URL` do apps/web (destino do rewrite de /v1) precisa apontar
# para um host DIFERENTE destes — normalmente o endereço interno do serviço de API. Se o proxy
# bater no mesmo host de API_PUBLIC_URL, o /v1 que o web usa cairia na superfície de máquina.
# Em dev (web 3000 → API 3100) dá para exercitar os hosts sem DNS usando nomes de loopback
# distintos, mantendo o proxy em localhost:
#   API_PUBLIC_URL=http://127.0.0.1:3100
#   MCP_PUBLIC_URL=http://127.0.0.2:3100

# Estratégia 100% Open Source / Open Core (Community vs Cloud / SaaS, controlada por flags):
# true = modo Community/Self-Hosted (recursos liberados e limites sem cobrança)
# false = modo Cloud / SaaS (ativa enforcement comercial de planos Grátis/Pro/Premium)
IS_SELF_HOSTED=true
# true = oculta botões de upgrade e telas de faturamento da Stripe na UI
HIDE_BILLING=true

# Cobrança (Stripe) — SÓ no gerenciado (IS_SELF_HOSTED=false e HIDE_BILLING=false).
# Sem STRIPE_SECRET_KEY não há cobrança nem bloqueio de plano: a instalação roda liberada.
# Passo a passo: 1) bun run stripe:sync cria os produtos/preços do catálogo na sua conta;
# 2) bun run stripe:webhook https://seu-dominio registra {PUBLIC_URL}/v1/stripe/webhook e
#    imprime o whsec_ (em dev: stripe listen --forward-to localhost:3100/v1/stripe/webhook).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# 0 = sem teste grátis (o plano Grátis já é permanente)
# BILLING_TRIAL_DAYS=0


DATABASE_URL=postgresql://manypost:manypost@localhost:5432/manypost
REDIS_URL=redis://localhost:6379

# Segredos DISTINTOS (o boot falha se forem iguais)
# openssl rand -hex 32
ENCRYPTION_KEY=

# Autenticação humana Clerk (configure publishable e secret key juntas).
# Use chaves da instância de desenvolvimento localmente e da instância de produção no Railway.
#NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
#CLERK_SECRET_KEY=
# Opcional: chave pública PEM para validar sessões sem chamada de descoberta.
#CLERK_JWT_KEY=

# local = volume em UPLOAD_DIR servido pela própria API em /uploads; s3 = bucket S3-compatível
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Limites de upload por tipo (MB)
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=200
# true só em dev/e2e: permite /v1/media/from-url apontar p/ rede privada (anti-SSRF desligado)
#MEDIA_ALLOW_PRIVATE_URLS=false

# URL base sob a qual as CHAVES de mídia são servidas publicamente (<base>/<orgId>/<arquivo>).
# A família Meta e o Dev.to fazem *pull* da mídia por essa URL, SEM credencial — por isso ela
# não pode depender da origem do app (em localhost a Meta não alcança e o post falha de forma
# permanente). Obrigatória com STORAGE_PROVIDER=s3; vazia no local = PUBLIC_URL/uploads.
#MEDIA_PUBLIC_URL=https://media.seudominio
# Bucket S3-compatível (Cloudflare R2, AWS S3, MinIO) — obrigatórias com STORAGE_PROVIDER=s3.
# Use UM BUCKET POR AMBIENTE: bucket compartilhado compartilha credencial e raio de dano.
#S3_BUCKET=
# auto no R2; a região real na AWS
#S3_REGION=auto
# obrigatório no R2/MinIO, dispensável na AWS
#S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# IA (SPEC_AI) — agnóstica de provedor
# ---------------------------------------------------------------------------
# `AI_PROVIDER` nomeia o PROTOCOLO HTTP falado, não o fornecedor. Trocar de fornecedor é
# mudar AI_BASE_URL/AI_MODEL — nunca código.
#
#   none                → IA desligada. As rotas /v1/ai respondem `capability.disabled` e a UI
#                         some com os botões. É o default, e mantém tudo funcionando sem IA.
#   openai-compatible   → dialeto `POST {AI_BASE_URL}/chat/completions`. É o que a maioria
#                         fala: gateways agregadores e runtimes locais (self-host).
#   anthropic           → dialeto `POST {AI_BASE_URL}/v1/messages`.
#
# Com AI_PROVIDER != none, AI_BASE_URL e AI_MODEL são OBRIGATÓRIAS e a aplicação recusa o boot
# sem elas. AI_API_KEY é opcional de propósito: runtime local costuma não pedir credencial.
AI_PROVIDER=none
#AI_BASE_URL=
#AI_API_KEY=
#AI_MODEL=

# --- Exemplos prontos (descomente UM bloco e preencha a chave) --------------
#
# 1) OpenAI
#AI_PROVIDER=openai-compatible
#AI_BASE_URL=https://api.openai.com/v1
#AI_API_KEY=sk-proj-...
#AI_MODEL=gpt-4.1-mini
#
# 2) Anthropic (Claude) — o único que usa o dialeto `anthropic`
#AI_PROVIDER=anthropic
#AI_BASE_URL=https://api.anthropic.com
#AI_API_KEY=sk-ant-api03-...
#AI_MODEL=claude-sonnet-4-5
#
# 3) Google Gemini (tem endpoint compatível com o dialeto de chat-completions)
#AI_PROVIDER=openai-compatible
#AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#AI_API_KEY=AIza...
#AI_MODEL=gemini-2.5-flash
#
# 4) Fireworks AI — atenção ao AI_BASE_URL: o caminho é /inference/v1, e o nome do modelo
#    é o caminho completo da conta. Reparado que NÃO se usa o endpoint /completions (legado,
#    de prompt cru): o adapter fala /chat/completions, que é o que o Fireworks também expõe.
#AI_PROVIDER=openai-compatible
#AI_BASE_URL=https://api.fireworks.ai/inference/v1
#AI_API_KEY=fw_...
#AI_MODEL=accounts/fireworks/models/deepseek-v4-pro
#
# 5) Groq / DeepSeek / Mistral / Together / OpenRouter — todos falam chat-completions
#AI_PROVIDER=openai-compatible
#AI_BASE_URL=https://api.groq.com/openai/v1
#AI_API_KEY=gsk_...
#AI_MODEL=llama-3.3-70b-versatile
#
# 6) Ollama local (self-host, SEM chave — é o caso que torna AI_API_KEY opcional)
#AI_PROVIDER=openai-compatible
#AI_BASE_URL=http://localhost:11434/v1
#AI_MODEL=llama3.2
#
# 7) LM Studio / vLLM local
#AI_PROVIDER=openai-compatible
#AI_BASE_URL=http://localhost:1234/v1
#AI_MODEL=<nome do modelo carregado>

# Alt text automático ("Descrever com IA" na biblioteca de mídia) exige um modelo que
# ENXERGUE imagem. Modelo só-texto continua servindo legenda/reescrita/hashtags; o botão de
# alt text simplesmente não aparece, e a rota responde 501 `ai.capability_unavailable`.
#
# Atenção ao alt text no dialeto `openai-compatible`: a imagem vai por URL, então o provedor
# precisa CONSEGUIR baixar a mídia. Em dev com MEDIA_PUBLIC_URL apontando para localhost isso
# não funciona (mesma limitação que a família Meta tem). O dialeto `anthropic` não sofre disso:
# lá os bytes vão embutidos.

# Teto de tempo de UMA chamada ao modelo, em ms (default 45000). Protege a requisição HTTP de
# ficar pendurada num provedor lento.
#AI_TIMEOUT_MS=45000
# Teto de tokens de saída por chamada (default 4000). Protege de custo aberto numa resposta
# desgovernada; o caso de uso pede menos que isso quando o limite do canal é menor.
#
# ATENÇÃO a MODELO DE RACIOCÍNIO (deepseek-v4-pro, o3, as variantes "thinking"): ele gasta
# tokens de SAÍDA pensando antes de escrever a primeira letra, então o teto que basta para um
# modelo comum o corta no meio da palavra. Não devolvemos resposta cortada como se estivesse
# pronta: vira `ai.invalid_response` nomeando esta variável. Com modelo de raciocínio, suba
# para 8000–16000.
#AI_MAX_OUTPUT_TOKENS=4000

# Modelo de IMAGEM (`ai_image`, plano Premium — 5 créditos por imagem). Opcional: sem ele, a
# geração usa AI_MODEL. Configure aqui quando o modelo de texto escolhido não desenha — assim
# uma instalação só atende os dois casos. Sem provedor capaz de gerar imagem, a rota responde
# `capability.disabled` e a interface esconde a ação.
# Opt-in: modelo capaz de gerar imagem; ausente mantém a capacidade desativada
#AI_IMAGE_MODEL=

# Franquia mensal de IA (créditos) NÃO é variável de ambiente: vem do catálogo de planos em
# packages/contracts/src/billing.ts (Grátis 0 / Pro 500 / Premium 2000). Em self-hosted
# (IS_SELF_HOSTED=true) o consumo é contabilizado mas NUNCA recusado — quem paga a chave é você.

LOG_LEVEL=info
#OTEL_EXPORTER_OTLP_ENDPOINT=
# /metrics (Prometheus): setado = exige Authorization: Bearer <token>; vazio = /metrics aberto
#METRICS_TOKEN=

# Credenciais por rede social (provider sem env some do catálogo).
# COMO CONSEGUIR CADA UMA, passo a passo e sem tecniquês: docs/principal/INTEGRATIONS_SETUP.md
#MASTODON_DEFAULT_INSTANCE=https://mastodon.social
# Bluesky: não precisa de env (handle + app password na tela de conexão)
#TELEGRAM_BOT_TOKEN=
# Discord (modo principal OAuth2 + Bot):
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#DISCORD_BOT_TOKEN=
# (Para usar Discord via Webhook leve sem app, não precisa de env — basta colar a URL do webhook na tela)
#REDDIT_CLIENT_ID=
#REDDIT_CLIENT_SECRET=
#LINKEDIN_CLIENT_ID=
#LINKEDIN_CLIENT_SECRET=
#X_CLIENT_ID=
#X_CLIENT_SECRET=
#PINTEREST_APP_ID=
#PINTEREST_APP_SECRET=
# YouTube (client OAuth "Web application" no Google Cloud + YouTube Data API v3 ativada;
# redirect: PUBLIC_URL/v1/channels/callback/youtube - precisa ser HTTPS. Escopos: SO
# youtube.upload e youtube.readonly - os dois sao sensiveis e passam pela verificacao do Google,
# entao nao adicione youtube/force-ssl/youtubepartner. O canal fica preso ao que voce escolher no
# seletor do Google durante o consentimento. Cota: ~6 videos/dia por projeto. Enquanto o projeto
# nao passar pela auditoria de conformidade, todo video sai PRIVADO mesmo pedindo publico - docs 5.1):
#YOUTUBE_CLIENT_ID=
#YOUTUBE_CLIENT_SECRET=
# Metricas do YouTube (opcional): exigem um TERCEIRO escopo sensivel (yt-analytics.readonly), que
# aumenta a verificacao do Google. Desligado, a rede publica normalmente e so as metricas ficam de
# fora. Ao ligar, RECONECTE o canal - o escopo entra no consentimento, nao no token existente.
#YOUTUBE_ENABLE_ANALYTICS=true
# Facebook Pages (app Meta, caso de uso "Manage everything on your Page"; App ID/secret em
# App settings > Basic; redirect em Facebook Login for Business > Settings > Valid OAuth Redirect URIs:
# PUBLIC_URL/v1/channels/callback/facebook — precisa ser HTTPS; escopos: pages_show_list,
# business_management, pages_manage_posts, pages_manage_engagement, pages_read_engagement,
# read_insights (adicionados em caso de uso > Permissions > Add). A Página é escolhida por post no
# compositor. A Meta faz *pull* da mídia: a URL do arquivo tem que ser pública — docs §5.2).
# ESTE PAR HABILITA DUAS REDES: `facebook` (Página) e `instagram` (Instagram via Facebook Business,
# caso de uso "Manage messaging and content on Instagram" > painel "API setup with Facebook login",
# redirect PUBLIC_URL/v1/channels/callback/instagram; escopos instagram_basic,
# instagram_content_publish, pages_show_list, pages_read_engagement, business_management,
# instagram_manage_comments, instagram_manage_insights — some no diálogo se você não os marcar):
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=
# Threads (app Meta, caso de uso "Access the Threads API"; o Threads App ID/secret ficam no painel do
# caso de uso, NÃO em App settings > Basic; redirect: PUBLIC_URL/v1/channels/callback/threads
# — precisa ser HTTPS; escopos: threads_basic, threads_content_publish, threads_manage_replies,
# threads_manage_insights. A Meta faz *pull* da mídia: a URL do arquivo tem que ser pública — docs §5.2):
#THREADS_APP_ID=
#THREADS_APP_SECRET=
# Instagram standalone (Instagram Login, SEM Página do Facebook — caso de uso "Manage messaging and
# content on Instagram" > painel "API setup with Instagram business login"; o Instagram app ID/secret
# ficam nesse painel, NÃO em App settings > Basic;
# redirect: PUBLIC_URL/v1/channels/callback/instagram-standalone — HTTPS; escopos: instagram_business_basic,
# instagram_business_content_publish, instagram_business_manage_comments, instagram_business_manage_insights.
# Conta precisa ser comercial/criador. A Meta faz *pull* da mídia: a URL do arquivo tem que ser pública):
#INSTAGRAM_APP_ID=
#INSTAGRAM_APP_SECRET=
# Twitch (publica no CHAT ao vivo ou como anúncio do canal — não é feed de posts;
# app em dev.twitch.tv/console/apps; redirect: PUBLIC_URL/v1/channels/callback/twitch;
# escopos: user:write:chat, user:read:chat, moderator:manage:announcements):
#TWITCH_CLIENT_ID=
#TWITCH_CLIENT_SECRET=
# Kick (publica no CHAT ao vivo; app em kick.com/settings/developer, OAuth 2.1 + PKCE;
# redirect: PUBLIC_URL/v1/channels/callback/kick; escopos: chat:write, user:read, channel:read):
#KICK_CLIENT_ID=
#KICK_CLIENT_SECRET=
# TikTok (Content Posting API — Login Kit; redirect: PUBLIC_URL/v1/channels/callback/tiktok;
# escopos: user.info.basic, user.info.profile, video.publish, video.upload — docs §5.3):
#TIKTOK_CLIENT_KEY=
#TIKTOK_CLIENT_SECRET=
